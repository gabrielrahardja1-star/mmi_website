# Copy to .env and fill in. Never commit .env.

# Central Postgres on the VPS. Database and role are created with /opt/postgres/scripts/add-app.sh
DATABASE_URL=postgres://mmi_website_user:CHANGE_ME@localhost:5432/mmi_website

# Hostnames the app answers on. Public site and editor are the same container, split by Host header.
PUBLIC_HOST=localhost:3000
CMS_HOST=cms.localhost:3000
PUBLIC_ORIGIN=http://localhost:3000
CMS_ORIGIN=http://cms.localhost:3000

# Session signing secret for the editor login (32+ random chars: openssl rand -base64 32)
AUTH_SECRET=CHANGE_ME

# Where uploaded photos are stored. In Docker this is a bind-mounted folder.
UPLOAD_DIR=./uploads
