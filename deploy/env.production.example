# Copy to /opt/mmi_website/.env on the VPS (chmod 600). Never commit the real file.

# Database on the shared Postgres. Created with: cd /opt/postgres && scripts/add-app.sh mmi_website_user '<password>' mmi_website
# Use a password with only letters and digits (openssl rand -hex 24), so it is safe inside this URL.
DATABASE_URL=postgres://mmi_website_user:CHANGE_ME@postgres:5432/mmi_website

# One container answers on two hostnames. These must match what nginx passes as the Host header.
PUBLIC_HOST=mergecoal.com
CMS_HOST=cms.mmiinternal.online
PUBLIC_ORIGIN=https://mergecoal.com
CMS_ORIGIN=https://cms.mmiinternal.online

# Signs editor login sessions. Generate with: openssl rand -base64 32
# Changing it signs everyone out.
AUTH_SECRET=CHANGE_ME

# Where photos are stored inside the container. docker-compose.yml mounts /opt/mmi_website/uploads here.
UPLOAD_DIR=/app/uploads

# Keep "false" until launch day, then set "true" and run: docker compose up -d
SITE_INDEXABLE=false

# Port on the VPS (localhost only) that nginx forwards to. Must be free, and match the nginx files.
APP_PORT=3140
